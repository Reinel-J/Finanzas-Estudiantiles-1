# Copia este archivo a .env y ajusta los valores si lo necesitas.
# Todos son opcionales: docker-compose.yml tiene valores por defecto.

# Puertos expuestos en tu máquina
FRONTEND_PORT=8080
BACKEND_PORT=8081
DB_PORT=3307

# Contraseña de root de MySQL
DB_PASSWORD=1234

# Mostrar SQL de Hibernate en los logs del backend (true/false)
SHOW_SQL=false

# Zona horaria del backend (afecta las fechas "de hoy")
TZ=America/Bogota

# API key de ExchangeRate-API (opcional; sin ella se usa el endpoint abierto)
MONEDA_API_KEY=

# Mercado Libre OAuth (déjalos vacíos si no usas la integración)
ML_OAUTH_CLIENT_ID=
ML_OAUTH_CLIENT_SECRET=
ML_OAUTH_REDIRECT_URI=
